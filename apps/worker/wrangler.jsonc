{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webflipper",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "../web/dist/client", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/ws"] },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "RoomDurableObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDurableObject"] }],
  "r2_buckets": [{ "binding": "CANVAS", "bucket_name": "webflipper-canvas" }]
}
