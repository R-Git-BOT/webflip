{
  "name": "webflipper",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,blue \"pnpm --filter @webflipper/local-server dev\" \"pnpm --filter @webflipper/web dev\"",
    "dummy:host": "pnpm --filter @webflipper/local-server dummy:host",
    "dummy:participant": "pnpm --filter @webflipper/local-server dummy:participant",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:worker:e2e": "playwright test --config playwright.worker.config.ts",
    "test:trial:e2e": "playwright test --config playwright.trial.config.ts",
    "deploy:trial": "node scripts/prepare-trial-secrets.mjs && pnpm build:worker && pnpm --filter @webflipper/worker exec wrangler deploy --secrets-file .wrangler/trial-secrets.json",
    "build:worker": "pnpm --filter @webflipper/web build && pnpm --filter @webflipper/worker bundle"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^24.6.0",
    "concurrently": "^9.2.1",
    "jsqr": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
